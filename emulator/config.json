{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Queues": [],
        "Topics": [
          {
            "Name": "loan-events",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT5M",
              "RequiresDuplicateDetection": false
            },
            "Subscriptions": [
              {
                "Name": "funding-loan-approved",
                "Properties": {
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT30S",
                  "MaxDeliveryCount": 5,
                  "DeadLetteringOnMessageExpiration": true
                },
                "Rules": [
                  {
                    "Name": "OnlyLoanApproved",
                    "Properties": {
                      "FilterType": "Correlation",
                      "CorrelationFilter": { "Subject": "LoanApproved" }
                    }
                  }
                ]
              },
              {
                "Name": "servicing-loan-funded",
                "Properties": {
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT30S",
                  "MaxDeliveryCount": 5,
                  "DeadLetteringOnMessageExpiration": true
                },
                "Rules": [
                  {
                    "Name": "OnlyLoanFunded",
                    "Properties": {
                      "FilterType": "Correlation",
                      "CorrelationFilter": { "Subject": "LoanFunded" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "Logging": { "Type": "File" }
  }
}
